# Server
NODE_ENV=development
PORT=3000
API_KEY=change-me-to-a-secure-key

# Database
DATABASE_URL=postgresql://lkchatbot:lkchatbot@localhost:5432/lk_chatbot

# Redis
REDIS_URL=redis://localhost:6379

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me

# AI Providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
AI_PRIMARY_PROVIDER=claude
AI_PRIMARY_MODEL=claude-haiku-4-5-20251001
AI_QUALIFICATION_MODEL=claude-sonnet-4-5-20250929

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Whisper (Voice Transcription)
WHISPER_MODEL=whisper-1

# Email (Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Webhook
WEBHOOK_BASE_URL=http://localhost:3000
