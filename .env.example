# =============================================================================
# LK Chatbot — Environment Variables
# =============================================================================
# For Railway deployment: most of these are set automatically by plugins
# or via the deploy/railway-setup.sh script.
# For local dev: copy this file to .env and fill in your values.
# =============================================================================

# Server
NODE_ENV=development
PORT=3000
API_KEY=change-me-to-a-secure-key
ADMIN_PASSWORD=change-me-to-a-secure-password

# JWT Authentication
# IMPORTANT: Change this to a strong random secret in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRES_IN=7d

# Database
# Railway: auto-injected by the Postgres plugin. If you need to set it manually
# in Railway's variable UI, use the reference: ${{Postgres.DATABASE_URL}}
# Local dev: point at your local PostgreSQL instance.
DATABASE_URL=postgresql://lkchatbot:lkchatbot@localhost:5432/lk_chatbot

# Redis
# Railway: auto-injected by the Redis plugin. Manual reference: ${{Redis.REDIS_URL}}
# Local dev: point at your local Redis instance.
REDIS_URL=redis://localhost:6379

# WhatsApp Number (for seed script)
# Used by: npx tsx scripts/seed-tenant.ts
# Can also pass as CLI arg: npx tsx scripts/seed-tenant.ts 5511999999999
WHATSAPP_NUMBER=5511959041799

# Evolution API (WhatsApp)
# Railway: use the internal URL of your Evolution API service
#   e.g., http://evolution-api.railway.internal:8080
# Local: http://localhost:8080
EVOLUTION_API_URL=http://localhost:8080
# IMPORTANT: This key must match the AUTHENTICATION_API_KEY in docker-compose.yml
EVOLUTION_API_KEY=your-secure-evolution-key-here

# AI Providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
AI_PRIMARY_PROVIDER=claude
AI_PRIMARY_MODEL=claude-haiku-4-5-20251001
AI_QUALIFICATION_MODEL=claude-sonnet-4-5-20250929

# Facebook Lead Ads (optional — for receiving leads from Facebook/Instagram ads)
# VERIFY_TOKEN: any string you choose, must match what you enter in Facebook Developer Portal
# APP_SECRET: from Facebook App > Settings > Basic > App Secret (for webhook signature verification)
# PAGE_ACCESS_TOKEN: from Facebook Page > Settings > Page Access Token (for Graph API lead retrieval)
FACEBOOK_VERIFY_TOKEN=lk-chatbot-fb-verify-2024
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Google Calendar (optional — for booking integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Stripe Billing (optional — for subscription management)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create products/prices in Stripe Dashboard, then paste the price IDs here:
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Diagnostic Tool Integration (optional — for receiving diagnostic results)
# Shared secret for HMAC-SHA256 webhook signature verification.
# The diagnostic tool must sign payloads with this secret and send the
# signature in the x-diagnostic-signature header.
# Alternatively, the tool can send x-api-key header matching API_KEY above.
DIAGNOSTIC_WEBHOOK_SECRET=

# Email / SMTP (optional — for notifications like review requests)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Webhook
# Railway: your public Railway URL, e.g., https://lk-chatbot.up.railway.app
# Local: http://localhost:3000 (or http://host.docker.internal:3000 for Docker)
WEBHOOK_BASE_URL=http://localhost:3000
