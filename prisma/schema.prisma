generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Multi-Tenant ────────────────────────────────────────────

model Tenant {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessName        String   @map("business_name")
  whatsappNumber      String?  @unique @map("whatsapp_number")
  evolutionInstanceId String?  @map("evolution_instance_id")
  timezone            String   @default("America/Sao_Paulo")
  businessHours       Json     @map("business_hours")
  aiConfig            Json     @map("ai_config")
  bookingConfig       Json?    @map("booking_config")
  notificationConfig  Json?    @map("notification_config")
  reviewConfig        Json?    @map("review_config")  // { googleUrl?, facebookUrl?, delayHours? }
  status              String   @default("onboarding") // onboarding, active, suspended
  plan                String   @default("starter")    // starter, pro, enterprise
  stripeCustomerId    String?  @unique @map("stripe_customer_id")
  apiKey              String?  @unique @map("api_key")
  monthlyAiCostUsd    Float    @default(0) @map("monthly_ai_cost_usd")
  aiCostLimitUsd      Float?   @map("ai_cost_limit_usd")
  costResetMonth      String?  @map("cost_reset_month") // YYYY-MM format
  messagesThisMonth   Int      @default(0) @map("messages_this_month")
  messageMonthStart   String?  @map("message_month_start") // YYYY-MM format
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Concierge-specific fields (dental/medical compliance)
  qualificationRules Json?    @map("qualification_rules") // { weights, near_term_keywords, qualified_threshold }
  handoffNumber      String?  @map("handoff_number")       // WhatsApp number for clinic staff notifications
  assessmentDesc     String?  @map("assessment_desc")      // Description of the evaluation/consultation
  toneNotes          String?  @map("tone_notes")           // Extra tone guidance for the AI
  complianceEnabled  Boolean  @default(false) @map("compliance_enabled") // Enable CFO/CRO compliance gate

  contacts        Contact[]
  conversations   Conversation[]
  messages        Message[]
  bookings        Booking[]
  campaigns       Campaign[]
  notifications   Notification[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  reviews         Review[]
  users           TenantUser[]
  complianceAudits ComplianceAudit[]
  handoffs        Handoff[]
  events          Event[]

  @@map("tenants")
}

// ─── Tenant Users (Portal Auth) ─────────────────────────────

model TenantUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id")
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         String    @default("owner") // owner, staff
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_users")
}

// ─── Admin Users (Platform Admins) ──────────────────────────

model AdminUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         String    @default("admin") // superadmin, admin, viewer
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@map("admin_users")
}

// ─── Audit Log ──────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String?  @map("admin_user_id")
  action      String   // tenant.create, tenant.delete, tenant.update, admin.login, etc.
  entityType  String?  @map("entity_type") // tenant, campaign, booking, admin_user
  entityId    String?  @map("entity_id")
  details     Json?    // Additional context
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Contacts / Leads ────────────────────────────────────────

model Contact {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id")
  phone             String
  name              String?
  email             String?
  channel           String    @default("whatsapp") // whatsapp, web
  leadScore         Int       @default(0) @map("lead_score")
  leadStatus        String    @default("new") @map("lead_status") // new, qualifying, qualified, booked, lost
  qualificationData Json?     @map("qualification_data")
  tags              String[]
  firstContactAt    DateTime  @default(now()) @map("first_contact_at")
  lastContactAt     DateTime? @map("last_contact_at")
  optedOut          Boolean   @default(false) @map("opted_out")
  optedOutAt        DateTime? @map("opted_out_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  bookings      Booking[]
  campaignContacts CampaignContact[]
  reviews       Review[]
  handoffs      Handoff[]

  @@unique([tenantId, phone])
  @@index([tenantId, phone])
  @@map("contacts")
}

// ─── Conversations ───────────────────────────────────────────

model Conversation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id")
  contactId     String    @map("contact_id")
  channel       String    @default("whatsapp") // whatsapp, web
  status        String    @default("active") // active, paused, closed, escalated
  stage         String    @default("saudacao") // saudacao, descoberta, qualificacao, valor, agendamento, encaminhamento, encerramento
  context       Json?     // AI conversation summary/context
  startedAt     DateTime  @default(now()) @map("started_at")
  lastMessageAt DateTime? @map("last_message_at")
  closedAt      DateTime? @map("closed_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]
  handoffs Handoff[]

  @@index([tenantId, contactId])
  @@map("conversations")
}

// ─── Messages ────────────────────────────────────────────────

model Message {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId     String   @map("conversation_id")
  tenantId           String   @map("tenant_id")
  direction          String   // inbound, outbound
  messageType        String   @map("message_type") // text, image, audio, document, interactive
  content            String?
  mediaUrl           String?  @map("media_url")
  whatsappMessageId  String?  @map("whatsapp_message_id")
  aiModelUsed        String?  @map("ai_model_used")
  aiTokensUsed       Int?     @map("ai_tokens_used")
  aiCostUsd          Float?   @map("ai_cost_usd")
  status             String   @default("sent") // sent, delivered, read, failed
  createdAt          DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  complianceAudits ComplianceAudit[]

  @@unique([whatsappMessageId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ─── Bookings ────────────────────────────────────────────────

model Booking {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id")
  contactId       String   @map("contact_id")
  appointmentType String?  @map("appointment_type")
  scheduledAt      DateTime? @map("scheduled_at")
  preferredDay     String?   @map("preferred_day")     // e.g. "segunda", "terça", "2026-06-01"
  preferredPeriod  String?   @map("preferred_period")  // e.g. "manha", "tarde", "noite"
  durationMinutes  Int       @default(30) @map("duration_minutes")
  status           String    @default("confirmed") // confirmed, cancelled, completed, no_show, solicitado
  calendarEventId String?  @map("calendar_event_id")
  meetLink        String?  @map("meet_link")
  reminderSent    Boolean  @default(false) @map("reminder_sent")
  noShowFollowUpSent Boolean @default(false) @map("no_show_follow_up_sent")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, scheduledAt])
  @@map("bookings")
}

// ─── Campaigns (Cold Outreach) ───────────────────────────────

model Campaign {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id")
  name            String
  status          String    @default("draft") // draft, active, paused, completed
  messageTemplate String    @map("message_template")
  targetCount     Int       @default(0) @map("target_count")
  sentCount       Int       @default(0) @map("sent_count")
  replyCount      Int       @default(0) @map("reply_count")
  qualifiedCount  Int       @default(0) @map("qualified_count")
  bookedCount     Int       @default(0) @map("booked_count")
  sendRatePerDay  Int       @default(20) @map("send_rate_per_day")
  scheduledStart  DateTime? @map("scheduled_start")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts CampaignContact[]

  @@index([tenantId, status])
  @@map("campaigns")
}

model CampaignContact {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String    @map("campaign_id")
  contactId  String    @map("contact_id")
  status     String    @default("pending") // pending, sent, replied, opted_out, failed
  sentAt     DateTime? @map("sent_at")
  repliedAt  DateTime? @map("replied_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("campaign_contacts")
}

// ─── Notifications ───────────────────────────────────────────

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id")
  type      String    // new_lead, booking, escalation, daily_summary
  channel   String    // whatsapp, email, webhook
  recipient String
  content   String?
  status    String    @default("pending") // pending, sent, failed
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type])
  @@map("notifications")
}

// ─── Subscriptions (Stripe) ─────────────────────────────────

model Subscription {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id")
  stripeSubscriptionId String    @unique @map("stripe_subscription_id")
  stripePriceId        String    @map("stripe_price_id")
  plan                 String    // starter, pro, enterprise
  status               String    // active, past_due, canceled, trialing, unpaid
  currentPeriodStart   DateTime  @map("current_period_start")
  currentPeriodEnd     DateTime  @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime? @map("canceled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscriptions")
}

// ─── Invoices (Stripe) ──────────────────────────────────────

model Invoice {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id")
  stripeInvoiceId  String    @unique @map("stripe_invoice_id")
  amountDue        Int       @map("amount_due")       // in cents
  amountPaid       Int       @default(0) @map("amount_paid")  // in cents
  currency         String    @default("brl")
  status           String    // draft, open, paid, void, uncollectible
  invoiceUrl       String?   @map("invoice_url")
  invoicePdf       String?   @map("invoice_pdf")
  periodStart      DateTime  @map("period_start")
  periodEnd        DateTime  @map("period_end")
  paidAt           DateTime? @map("paid_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("invoices")
}

// ─── Reviews (Post-appointment) ─────────────────────────────

model Review {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id")
  contactId       String    @map("contact_id")
  bookingId       String?   @map("booking_id")
  rating          Int?      // 1-5 stars
  comment         String?
  status          String    @default("pending") // pending, sent, responded, expired
  reviewLink      String?   @map("review_link") // Google/Facebook review URL
  requestSentAt   DateTime? @map("request_sent_at")
  respondedAt     DateTime? @map("responded_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("reviews")
}

// ─── Compliance Audit (CFO/CRO Gate) ──────────────────────────

model ComplianceAudit {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId      String?  @map("message_id")
  conversationId String   @map("conversation_id")
  tenantId       String   @map("tenant_id")
  outboundText   String   @map("outbound_text")
  model          String
  checks         Json     // { regex_flags: string[], model_flag: boolean }
  passed         Boolean
  flaggedTerms   String[] @map("flagged_terms")
  createdAt      DateTime @default(now()) @map("created_at")

  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([conversationId])
  @@map("compliance_audits")
}

// ─── Handoffs (Escalation to Human Staff) ─────────────────────

model Handoff {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId         String   @map("lead_id")
  conversationId String   @map("conversation_id")
  tenantId       String   @map("tenant_id")
  reason         String?  // agendamento, compliance, emergencia, user_request, etc.
  summary        String?
  status         String   @default("pendente") // pendente, atendido, encerrado
  createdAt      DateTime @default(now()) @map("created_at")

  contact      Contact      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("handoffs")
}

// ─── Events (Event Sourcing / Activity Log) ───────────────────

model Event {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId    String?  @map("lead_id")
  tenantId  String   @map("tenant_id")
  type      String   // message_in, lead_in, message_out, agendar, encaminhar, desqualificar, opt_out, continuar
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@map("events")
}
